{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "PUT_DATABASE_CONNECTION_STRING_HERE",
    "Redis": "PUT_REDIS_CONNECTION_STRING_HERE"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/bookly-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "PUT_SEQ_INGESTION_URL_HERE"
        }
      }
    ]
  },

  "JwtOptions": {
    "Key": "PUT_JWT_SECRET_KEY_HERE",
    "Audience": "Bookly",
    "Issuer": "Bookly",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "EmailOptions": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Bookly",
    "SenderEmail": "PUT_SENDER_EMAIL_HERE",
    "Username": "PUT_EMAIL_USERNAME_HERE",
    "Password": "PUT_EMAIL_APP_PASSWORD_HERE"
  },

  "AppSettings": {
    "BaseUrl": "PUT_PRODUCTION_BASE_URL_HERE"
  },

  "Stripe": {
    "SecretKey": "PUT_STRIPE_SECRET_KEY_HERE",
    "Currency": "egp",
    "WebhookSecret": "PUT_STRIPE_WEBHOOK_SECRET_HERE",
    "SuccessUrl": "PUT_STRIPE_SUCCESS_URL_HERE",
    "CancelUrl": "PUT_STRIPE_CANCEL_URL_HERE"
  }
}
